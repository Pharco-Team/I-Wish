        body.setOpaque(false);
        JPanel filters = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 0));
        filters.setOpaque(false);
        for (String category : new String[]{"All", "Electronics", "Books", "Fashion", "Others"}) {
            JButton filter = new JButton(category);
            filter.setFocusPainted(false);
            filter.setBorder(new EmptyBorder(8, 15, 8, 15));
