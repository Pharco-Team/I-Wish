            case "Home" -> "Good Morning, Bicho!";
            case "Friends" -> "Your Friends";
            case "Wish Lists" -> "Wish Lists";
            case "Notifications" -> "Notifications";
            case "Settings" -> "Settings";
            default -> "i-Wish";
        });
        for (int i = 0; i < navButtons.size(); i++) {
            boolean selected = switch (i) {
                case 0 -> page.equals("Home");
                case 1 -> page.equals("Friends");
                case 2 -> page.equals("Wish Lists");
                case 3 -> page.equals("Notifications");
                default -> page.equals("Settings");
            };
            navButtons.get(i).setBackground(selected ? LIGHT_PURPLE : Color.WHITE);
            navButtons.get(i).setForeground(selected ? PRIMARY : MUTED);
        }
    }

