    private void styleAuthTab(JButton button, boolean selected) {
        button.setFont(new Font("SansSerif", Font.BOLD, 12));
        button.setForeground(selected ? PRIMARY : MUTED);
        button.setBackground(Color.WHITE);
        button.setBorder(BorderFactory.createMatteBorder(0, 0, selected ? 2 : 1, 0, selected ? PRIMARY : BORDER));
        button.setFocusPainted(false);
    }

    private JPanel authForm(String title, String subtitle, boolean register) {
        JPanel p = new JPanel();
        p.setOpaque(false);
        p.setLayout(new BoxLayout(p, BoxLayout.Y_AXIS));
        JLabel titleLabel = new JLabel(title);
        titleLabel.setFont(new Font("SansSerif", Font.BOLD, 25));
        titleLabel.setForeground(TEXT);
        JLabel sub = new JLabel(subtitle);
        sub.setFont(new Font("SansSerif", Font.PLAIN, 12));
        sub.setForeground(MUTED);
        p.add(titleLabel);
        p.add(Box.createVerticalStrut(5));
        p.add(sub);
        p.add(Box.createVerticalStrut(20));
        if (register) {
            p.add(fieldLabel("Full name", "Your name"));
            p.add(Box.createVerticalStrut(12));
        }
        p.add(fieldLabel("Email or Phone", "you@example.com"));
        p.add(Box.createVerticalStrut(12));
        p.add(fieldLabel("Password", "••••••••"));
        p.add(Box.createVerticalStrut(16));
        JButton submit = primaryButton(register ? "Create Account  →" : "Sign In  →");
        submit.setMaximumSize(new Dimension(Integer.MAX_VALUE, 44));
        submit.addActionListener(e -> showDashboard());
        p.add(submit);
        p.add(Box.createVerticalStrut(18));
        JLabel or = new JLabel("────────   or continue with   ────────", SwingConstants.CENTER);
        or.setForeground(MUTED);
        or.setFont(new Font("SansSerif", Font.PLAIN, 10));
        or.setAlignmentX(Component.CENTER_ALIGNMENT);
        p.add(or);
        p.add(Box.createVerticalStrut(10));
        JButton google = new JButton("◉  Continue with Google");
        JButton facebook = new JButton("●  Continue with Facebook");
        for (JButton social : new JButton[]{google, facebook}) {
            social.setFont(new Font("SansSerif", Font.BOLD, 11));
            social.setForeground(TEXT);
            social.setBackground(Color.WHITE);
            social.setBorder(BorderFactory.createLineBorder(BORDER));
            social.setFocusPainted(false);
            social.setMaximumSize(new Dimension(Integer.MAX_VALUE, 38));
            social.addActionListener(e -> showDashboard());
            p.add(social);
            p.add(Box.createVerticalStrut(8));
        }
        JLabel footer = new JLabel(register ? "Already have an account?  Sign In" : "Don't have an account?  Register", SwingConstants.CENTER);
        footer.setForeground(MUTED);
        footer.setFont(new Font("SansSerif", Font.PLAIN, 10));
        footer.setAlignmentX(Component.CENTER_ALIGNMENT);
        p.add(Box.createVerticalStrut(8));
        p.add(footer);
        return p;
    }

    private JPanel fieldLabel(String title, String placeholder) {
        JPanel group = new JPanel(new BorderLayout(0, 5));
        group.setOpaque(false);
        group.setMaximumSize(new Dimension(Integer.MAX_VALUE, 63));
        JLabel label = new JLabel(title);
        label.setFont(new Font("SansSerif", Font.BOLD, 11));
        label.setForeground(TEXT);
        JTextField input = new JTextField(placeholder);
        input.setFont(new Font("SansSerif", Font.PLAIN, 12));
        input.setForeground(MUTED);
        input.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(BORDER), new EmptyBorder(9, 10, 9, 10)));
        group.add(label, BorderLayout.NORTH);
        group.add(input, BorderLayout.CENTER);
        return group;
    }

