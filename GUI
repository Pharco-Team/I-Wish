    private JPanel friendsPage() {
        JPanel p = pagePanel();
        p.setLayout(new BorderLayout(0, 16));
        JPanel top = new JPanel(new BorderLayout());
        top.setOpaque(false);
        top.add(sectionTitle("My Friends"), BorderLayout.WEST);
