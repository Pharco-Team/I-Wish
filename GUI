        top.add(add, BorderLayout.EAST);
        JPanel list = cardPanel();
        list.setLayout(new BoxLayout(list, BoxLayout.Y_AXIS));
        SearchBox search = new SearchBox();
        list.add(search);
        list.add(Box.createVerticalStrut(14));
        for (Friend f : friends) {
            JPanel row = new JPanel(new BorderLayout(12, 0));
            row.setOpaque(false);
            row.setBorder(new EmptyBorder(9, 4, 9, 4));
            row.setMaximumSize(new Dimension(Integer.MAX_VALUE, 65));
            Avatar av = new Avatar(f.name.substring(0, 1), f.color);
            av.setPreferredSize(new Dimension(43, 43));
            JPanel info = new JPanel();
            info.setOpaque(false);
            info.setLayout(new BoxLayout(info, BoxLayout.Y_AXIS));
            JLabel n = new JLabel(f.name);
            n.setFont(new Font("SansSerif", Font.BOLD, 14));
            n.setForeground(TEXT);
            JLabel st = new JLabel("● " + f.status);
            st.setFont(new Font("SansSerif", Font.PLAIN, 11));
            st.setForeground(f.status.startsWith("Online") ? GREEN : MUTED);
            info.add(n);
            info.add(Box.createVerticalStrut(4));
            info.add(st);
            JButton wishes = smallButton("View Wishes");
            wishes.addActionListener(e -> showPage("Wish Lists"));
            row.add(av, BorderLayout.WEST);
            row.add(info, BorderLayout.CENTER);
            row.add(wishes, BorderLayout.EAST);
            list.add(row);
            list.add(new JSeparator());
        }
        p.add(top, BorderLayout.NORTH);
        p.add(list, BorderLayout.CENTER);
        return p;
    }

    private JPanel wishListPage() {
