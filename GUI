    private JPanel wishCard(String name, String price, int current, int total, String emoji) {
        JPanel card = cardPanel();
        card.setLayout(new BorderLayout(10, 8));

        JLabel picture = new JLabel(emoji, SwingConstants.CENTER);
        picture.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 48));
        picture.setOpaque(true);
        picture.setBackground(new Color(245, 246, 252));
        picture.setPreferredSize(new Dimension(85, 85));

        JPanel info = new JPanel();
        info.setOpaque(false);
        info.setLayout(new BoxLayout(info, BoxLayout.Y_AXIS));

        JLabel n = new JLabel(name);
        n.setFont(new Font("SansSerif", Font.BOLD, 15));
        n.setForeground(TEXT);

        JLabel pr = new JLabel(price);
        pr.setFont(new Font("SansSerif", Font.BOLD, 13));
        pr.setForeground(MUTED);

        JProgressBar bar = new JProgressBar(0, total);
        bar.setValue(current);
        bar.setPreferredSize(new Dimension(100, 8));
        bar.setMaximumSize(new Dimension(Integer.MAX_VALUE, 8));
        bar.setForeground(PRIMARY);
        bar.setBackground(new Color(231, 233, 243));
        bar.setBorderPainted(false);

        JLabel progress = new JLabel(current + " / " + total + " coins");
        progress.setFont(new Font("SansSerif", Font.PLAIN, 10));
        progress.setForeground(MUTED);

        info.add(n);
        info.add(Box.createVerticalStrut(5));
        info.add(pr);
        info.add(Box.createVerticalStrut(9));
        info.add(bar);
        info.add(Box.createVerticalStrut(4));
        info.add(progress);

        JButton contribute = primaryButton("Contribute");
        contribute.addActionListener(e -> openContribution(name, total));

        card.add(picture, BorderLayout.WEST);
        card.add(info, BorderLayout.CENTER);
        card.add(contribute, BorderLayout.EAST);
        return card;
    }

    private void openContribution(String wishName, int total) {
        JDialog dialog = new JDialog(this, "Contribute to a Wish", true);
        dialog.setSize(480, 570);
        dialog.setLocationRelativeTo(this);
        dialog.setResizable(false);

        JPanel root = new JPanel(new BorderLayout());
        root.setBackground(Color.WHITE);
        root.setBorder(new EmptyBorder(25, 28, 25, 28));

        JPanel header = new JPanel(new BorderLayout());
        header.setOpaque(false);

        JLabel title = new JLabel("Contribute to a Wish");
        title.setFont(new Font("SansSerif", Font.BOLD, 22));
        title.setForeground(TEXT);

        JButton close = new JButton("×");
        close.setFont(new Font("SansSerif", Font.BOLD, 22));
        close.setBorderPainted(false);
        close.setContentAreaFilled(false);
        close.addActionListener(e -> dialog.dispose());

        header.add(title, BorderLayout.WEST);
        header.add(close, BorderLayout.EAST);

        JPanel body = new JPanel();
        body.setOpaque(false);
        body.setLayout(new BoxLayout(body, BoxLayout.Y_AXIS));

        JLabel sub = new JLabel("<html>Help your friend get their dream item! 💜</html>");
        sub.setForeground(MUTED);
        sub.setFont(new Font("SansSerif", Font.PLAIN, 13));

        body.add(sub);
        body.add(Box.createVerticalStrut(18));

        JPanel wish = roundedPanel();
        wish.setLayout(new BorderLayout(12, 0));
        wish.setBorder(new EmptyBorder(14, 15, 14, 15));

        JLabel gift = new JLabel("🎁", SwingConstants.CENTER);
        gift.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 38));
        gift.setPreferredSize(new Dimension(58, 58));

        JPanel wi = new JPanel();
        wi.setOpaque(false);
        wi.setLayout(new BoxLayout(wi, BoxLayout.Y_AXIS));
        JLabel wn = new JLabel(wishName);
        wn.setFont(new Font("SansSerif", Font.BOLD, 15));
        wn.setForeground(TEXT);
        JLabel wp = new JLabel("$" + total + "   •   " + Math.min(120, total) + " / " + total + " coins");
        wp.setFont(new Font("SansSerif", Font.PLAIN, 12));
        wp.setForeground(MUTED);
        wi.add(wn);
        wi.add(Box.createVerticalStrut(5));
        wi.add(wp);

        wish.add(gift, BorderLayout.WEST);
        wish.add(wi, BorderLayout.CENTER);

        body.add(wish);
        body.add(Box.createVerticalStrut(20));

        JLabel choose = new JLabel("Choose your contribution");
        choose.setFont(new Font("SansSerif", Font.BOLD, 14));
        choose.setForeground(TEXT);
        body.add(choose);
        body.add(Box.createVerticalStrut(12));

        JPanel coins = new JPanel(new GridLayout(1, 4, 10, 0));
        coins.setOpaque(false);

        ButtonGroup group = new ButtonGroup();
        JToggleButton[] coinButtons = new JToggleButton[4];
        int[] values = {50, 100, 200, 500};

        for (int i = 0; i < values.length; i++) {
            final int index = i;
            JToggleButton b = new CoinButton(values[i]);
            group.add(b);
            coins.add(b);
            coinButtons[i] = b;
            b.addActionListener(e -> {
                for (int j = 0; j < coinButtons.length; j++) {
                    coinButtons[j].repaint();
                }
            });
        }

        body.add(coins);
        body.add(Box.createVerticalStrut(20));

        JLabel messageLabel = new JLabel("Message (optional)");
        messageLabel.setFont(new Font("SansSerif", Font.BOLD, 14));
        messageLabel.setForeground(TEXT);
        body.add(messageLabel);
        body.add(Box.createVerticalStrut(8));

        JTextArea message = new JTextArea(4, 30);
        message.setLineWrap(true);
        message.setWrapStyleWord(true);
        message.setFont(new Font("SansSerif", Font.PLAIN, 13));
        message.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(BORDER),
                new EmptyBorder(10, 10, 10, 10)
        ));
        body.add(message);

        body.add(Box.createVerticalStrut(18));

        JButton contribute = primaryButton("◉  Contribute Coins");
        contribute.setPreferredSize(new Dimension(0, 48));
        contribute.addActionListener(e -> {
            int selected = 0;
            for (int i = 0; i < coinButtons.length; i++) {
                if (coinButtons[i].isSelected()) selected = values[i];
            }
            if (selected == 0) {
                JOptionPane.showMessageDialog(dialog, "Please select a coin amount first.");
                return;
            }
            JOptionPane.showMessageDialog(dialog,
                    "Successfully contributed " + selected + " coins to " + wishName + "!",
                    "i-Wish",
                    JOptionPane.INFORMATION_MESSAGE);
            dialog.dispose();
        });
        body.add(contribute);

        root.add(header, BorderLayout.NORTH);
        root.add(body, BorderLayout.CENTER);

        dialog.setContentPane(root);
        dialog.setVisible(true);
    }

    private JPanel activityRow(String letter, Color color, String message, String time) {
        JPanel row = new JPanel(new BorderLayout(12, 0));
        row.setOpaque(false);
        row.setBorder(new EmptyBorder(10, 0, 10, 0));

        Avatar a = new Avatar(letter, color);
        a.setPreferredSize(new Dimension(40, 40));

        JPanel info = new JPanel();
        info.setOpaque(false);
        info.setLayout(new BoxLayout(info, BoxLayout.Y_AXIS));

        JLabel m = new JLabel(message);
        m.setFont(new Font("SansSerif", Font.BOLD, 12));
        m.setForeground(TEXT);

        JLabel t = new JLabel(time);
        t.setFont(new Font("SansSerif", Font.PLAIN, 10));
        t.setForeground(MUTED);

        info.add(m);
        info.add(Box.createVerticalStrut(4));
        info.add(t);

        JLabel arrow = new JLabel("›");
        arrow.setFont(new Font("SansSerif", Font.BOLD, 22));
        arrow.setForeground(MUTED);

        row.add(a, BorderLayout.WEST);
        row.add(info, BorderLayout.CENTER);
        row.add(arrow, BorderLayout.EAST);
        return row;
    }

