    private void showPage(String page) {
        cards.show(content, page);

        String title = switch (page) {
            case "Home" -> "Good Morning, Bicho!";
            case "Friends" -> "Your Friends";
            case "Wish Lists" -> "Wish Lists";
            case "Notifications" -> "Notifications";
            case "Settings" -> "Settings";
            default -> "i-Wish";
        };
        pageTitle.setText(title);

        for (Map.Entry<String, JButton> e : navButtons.entrySet()) {
            boolean selected = e.getKey().equals(page);
            e.getValue().setBackground(selected ? LIGHT_PURPLE : Color.WHITE);
            e.getValue().setForeground(selected ? PRIMARY : MUTED);
        }
    }

